# ═══════════════════════════════════════════════════════════════════════════
# [ LOCAL MAC ] — Docker Desktop for Mac
#
# network_mode: host does NOT reach the Mac's real localhost (Docker Desktop
# runs containers inside its own Linux VM) — ports are published instead, and
# host.docker.internal is used wherever the container needs to reach the Mac
# itself (Ollama, backend-from-frontend). See docker-compose.localmac.yml.
#
# Loaded via: docker compose --env-file .env.localMac (see Makefile `make local`)
# ═══════════════════════════════════════════════════════════════════════════

# — Backend / Server —
PORT=8420
CORS_ORIGIN=http://localhost:8421

# — Backend / Ollama — local Mac generation/embeddings go through the prod
# 42AI GPU via the /ollama test proxy (see backend/CLAUDE.md → "The /ollama
# test proxy") instead of a local (CPU, slow) Ollama. OLLAMA_PROXY_KEY (from
# .env.lab) is sent as the x-ollama-key header by ollama.service.js.
OLLAMA_BASE_URL=https://42gpt.42ai.net/ollama
# OLLAMA_GENERATION_MODEL=mistral:latest
OLLAMA_GENERATION_MODEL=ministral-3:3b
# OLLAMA_GENERATION_MODEL=ministral-3:8b
OLLAMA_EMBEDDING_MODEL=snowflake-arctic-embed:335m

# — Database (Postgres) — one container for the whole project. Password is the
# only secret and lives in .env.lab. On local Mac the backend and Postgres share
# the Compose bridge network, so the backend reaches it by service name on the
# in-container port. POSTGRES_HOST_PORT is only the loopback publish for host
# tools (make psql); the backend does not use it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=boby42
POSTGRES_DB=boby42
POSTGRES_HOST_PORT=5442

# — Frontend —
FRONTEND_PORT=8421
BACKEND_HOST=host.docker.internal
VITE_ALLOWED_HOSTS=localhost
VITE_API_URL=

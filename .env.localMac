# ═══════════════════════════════════════════════════════════════════════════
# [ LOCAL MAC ] — Docker Desktop for Mac
#
# network_mode: host does NOT reach the Mac's real localhost (Docker Desktop
# runs containers inside its own Linux VM) — ports are published instead, and
# host.docker.internal is used wherever the container needs to reach the Mac
# itself (Ollama, backend-from-frontend). See docker-compose.localmac.yml.
#
# Loaded via: docker compose --env-file .env.localMac (see Makefile `make local`)
# ═══════════════════════════════════════════════════════════════════════════

# — Backend / Server —
PORT=8420
CORS_ORIGIN=http://localhost:8421

# — Backend / Ollama — (host-local only, 127.0.0.1, shared 42AI config)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_GENERATION_MODEL=mistral:latest
OLLAMA_EMBEDDING_MODEL=snowflake-arctic-embed:335m

# — Frontend —
FRONTEND_PORT=8421
BACKEND_HOST=host.docker.internal
VITE_ALLOWED_HOSTS=localhost
VITE_API_URL=

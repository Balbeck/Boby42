{
  "name": "backend",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test --require ./test/env.js --test-concurrency=1 \"test/**/*.test.js\"",
    "start": "fastify start -l info app.js",
    "dev": "fastify start -w -l info -P app.js",
    "test:coverage": "node --test --require ./test/env.js --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"db/migrations/**\" --test-coverage-exclude=\"db/migrate.js\" --test-coverage-exclude=\"db/seed.js\" --test-coverage-exclude=\"db/umzug.js\" --test-coverage-exclude=\"scripts/**\" --test-coverage-exclude=\"app.js\" --test-coverage-exclude=\"types/types.js\" --test-coverage-lines=100 \"test/**/*.test.js\"",
    "test:unit": "node --test --require ./test/env.js --test-concurrency=1 \"test/unit/**/*.test.js\"",
    "test:coverage:unit": "node --test --require ./test/env.js --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-exclude=\"db/migrations/**\" --test-coverage-exclude=\"db/migrate.js\" --test-coverage-exclude=\"db/seed.js\" --test-coverage-exclude=\"db/umzug.js\" --test-coverage-exclude=\"scripts/**\" --test-coverage-exclude=\"app.js\" --test-coverage-exclude=\"types/types.js\" --test-coverage-lines=100 \"test/unit/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/sensible": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.0.0",
    "jsonwebtoken": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  }
}

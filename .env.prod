# ═══════════════════════════════════════════════════════════════════════════
# [ PROD ] — 42AI host (Linux)
#
# network_mode: host is used for both services (see docker-compose.prod.yml),
# so "localhost" inside either container is the host's real localhost —
# required because Ollama on the host only listens on 127.0.0.1:11434.
#
# Loaded via: docker compose --env-file .env.prod (see Makefile `make prod`)
# ═══════════════════════════════════════════════════════════════════════════

# — Backend / Server —
PORT=8420
CORS_ORIGIN=https://42gpt.42ai.net

# — Backend / Ollama — (host-local only, 127.0.0.1, shared 42AI config)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=mistral:latest
OLLAMA_EMBEDDING_MODEL=snowflake-arctic-embed:335m

# — Database (Postgres) — one container for the whole project. Password is the
# only secret and lives in .env.lab. In prod both services run network_mode:
# host, so there is no Compose network and no service-name DNS — the backend
# reaches Postgres through its loopback-published port on the host. Postgres
# itself stays on the default bridge and publishes 127.0.0.1:5442:5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5442
POSTGRES_USER=boby42
POSTGRES_DB=boby42
POSTGRES_HOST_PORT=5442

# — Frontend —
FRONTEND_PORT=8421
BACKEND_HOST=localhost
VITE_ALLOWED_HOSTS=42gpt.42ai.net
VITE_API_URL=

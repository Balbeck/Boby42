# ═══════════════════════════════════════════════════════════════════════════
# [ SECRETS ] — .env.lab   (git-ignored — copy this file to .env.lab and fill in)
#
# The only file in the repo that holds secrets. Loaded by the Makefile as a
# second --env-file on `make localMac` / `make prod`. .env.prod / .env.localMac
# stay committed and secret-free.
# ═══════════════════════════════════════════════════════════════════════════

# Postgres password. No default anywhere — Compose warns and the postgres
# container refuses to start without it.
POSTGRES_PASSWORD=

# /lab login — db/seed.js upserts one User row: login = LAB_LOGIN,
# password_hash = bcryptjs hash of LAB_PASSWORD. Leave both empty to keep the
# feature disabled (routes 404, page shows only the greeting).
LAB_LOGIN=
LAB_PASSWORD=

# Secret for signing the /lab session JWT (@fastify/jwt). Use a long random
# string, e.g. `openssl rand -hex 48`. Unset = the feature fails closed.
LAB_JWT_SECRET=

# # # # # # # # # # # #
# # * * * [ DEV ] * * *
# # # # # # # # # # # #
CORS_ORIGIN=http://localhost:8421

# # * [ Frontend ] * # - vite.config.js -
VITE_PROXY_TARGET=http://host.docker.internal:8420



# # # # # # # # # # # # #
# # * * * [ PROD ] * * *
# # # # # # # # # # # # #

# # * [ Frontend ] * # - vite.config.js -
VITE_PROXY_TARGET=http://localhost:8420





# # # # # # # # # # # # # #
# # * * * [ General ] * * *
# # # # # # # # # # # # # #

# # * [ Backend ] *
# # - Ollama -

# # [ PROD ]
# OLLAMA_BASE_URL=http://localhost:11434
# [ Dev Mac ]
OLLAMA_BASE_URL=http://host.docker.internal:11434

OLLAMA_GENERATION_MODEL=mistral:latest
OLLAMA_EMBEDDING_MODEL=snowflake-arctic-embed:335m
# # - Server -
PORT=8420
# CORS_ORIGIN=https://42gpt.42ai.net




# docker-compose.yaml
# backend environement:
# OLLAMA_BASE_URL:-http://localhost:11434 # prod
# OLLAMA_BASE_URL:-http://host.docker.internal:11434 # dev
#
# Dans le docker-compose.yaml, pour passer de dev a prod il faut :
# 	backend:	[Prod]	network_mode: host --> ports: "8420:820" [Dev]
# 	frontend:	[Prod]	network_mode: host --> ports: "8421:821" [Dev]

# ./frontend/vite.config.js
# proxy: {
#   // // * * * [ Prod ] * * *
#   // Le backend tourne en network_mode: host sur la machine hôte ; ce container
#   // partage donc la même stack réseau (voir docker-compose.yml) et localhost:8420
#   // le joint directement, sans passer par un second tunnel Cloudflare.
#   // '/chat': 'http://localhost:8420',
#   // // * * * [ Dev ]
#   '/chat': 'http://host.docker.internal:8420',

# ./frontend/Dockerfile
# EXPOSE 8421
# CMD ["sh", "-c", "npm install && npm run dev -- --host 0.0.0.0 --port 8421"]

# ./backend/Dockerfile
# EXPOSE 8420
# CMD ["sh", "-c", "npm install && npm run dev"]








# # =============================================================================
# # .env — point d'entrée unique des variables d'environnement du projet
# # (backend + frontend). Ces variables sont injectées dans chaque conteneur
# # via les blocs `environment:` de docker-compose.yml (substitution ${VAR:-...}).
# #
# # Deux sections ci-dessous : PROD (active) et DEV (désactivée, commentée).
# # Pour passer en dev : commenter entièrement la section PROD, décommenter
# # entièrement la section DEV. Ne jamais activer les deux blocs en même temps
# # (mêmes clés dans les deux → conflit).
# # =============================================================================

# # ─────────────────────────────── [ PROD ] — active ───────────────────────────

# # # - - - [ Backend / Server ] - - -
# # PORT=8420
# # CORS_ORIGIN=https://42gpt.42ai.net # prod

# # # - - - [ Backend / Ollama ] - - -
# # OLLAMA_BASE_URL=http://localhost:11434
# # OLLAMA_GENERATION_MODEL=mistral:latest
# # OLLAMA_EMBEDDING_MODEL=snowflake-arctic-embed:335m

# # # - - - [ Frontend ] - - -
# # FRONTEND_PORT=8421
# # VITE_ALLOWED_HOSTS=42gpt.42ai.net
# # VITE_PROXY_TARGET=http://localhost:8420
# # # VITE_API_URL= # laissé vide : chemin relatif /chat, relayé par le proxy Vite

# # ─────────────────────────────── [ DEV ] — désactivée ────────────────────────

# # - - - [ Backend / Server ] - - -
# PORT=8420
# CORS_ORIGIN=http://localhost:8421 # dev

# # - - - [ Backend / Ollama ] - - -
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_GENERATION_MODEL=mistral:latest
# OLLAMA_EMBEDDING_MODEL=snowflake-arctic-embed:335m

# # - - - [ Frontend ] - - -
# FRONTEND_PORT=8421
# VITE_ALLOWED_HOSTS=localhost
# VITE_PROXY_TARGET=http://127.0.0.1:8420
# VITE_API_URL=http://localhost:8420
